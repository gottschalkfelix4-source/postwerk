# Vollständiger Hostname des Mailservers (A-Record + Reverse-DNS müssen darauf zeigen)
POSTWERK_HOSTNAME=mail.example.com

# Erstes Admin-Konto (wird nur beim allerersten Start angelegt).
# Ohne Passwort erzeugt Postwerk eins und schreibt es ins Log.
POSTWERK_ADMIN_EMAIL=admin@example.com
POSTWERK_ADMIN_PASSWORD=

# Session-Cookie nur über HTTPS senden (empfohlen, sobald HTTPS läuft)
POSTWERK_SECURE_COOKIES=false

# Hinter einem Reverse-Proxy (Traefik, Nginx Proxy Manager, ...) auf true setzen,
# damit die echte Client-IP für den Brute-Force-Schutz verwendet wird.
POSTWERK_TRUST_PROXY=false

# Optional: eigenes Zertifikat statt Let's Encrypt (Pfade im Container)
# POSTWERK_TLS_CERT=/data/certs/fullchain.pem
# POSTWERK_TLS_KEY=/data/certs/privkey.pem

# Optional: Smarthost für ausgehende Mails (falls Port 25 beim Provider gesperrt ist)
# POSTWERK_RELAY_HOST=smtp.provider.de:587
# POSTWERK_RELAY_USER=
# POSTWERK_RELAY_PASSWORD=

# Optional: Token für /metrics (Prometheus)
# POSTWERK_METRICS_TOKEN=

# Host-Ports der Weboberfläche (für ACME HTTP-01 muss 80 von außen erreichbar sein)
# HTTP_PORT=80
# HTTPS_PORT=443

# Nur auf bestimmter IP lauschen
# BIND_IP=0.0.0.0

# Modelle für das Profil "ai"
AI_CHAT_MODEL=qwen2.5:7b
AI_EMBED_MODEL=nomic-embed-text

POSTWERK_DEBUG=false
