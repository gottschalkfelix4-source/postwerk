# Vollständiger Hostname des Mailservers (A-Record + Reverse-DNS müssen darauf zeigen)
POSTWERK_HOSTNAME=mail.example.com

# Erstes Admin-Konto – leer lassen, um den Setup-Assistenten in der Weboberfläche zu nutzen
# (Setup-Token anzeigen: docker compose exec postwerk postwerk setup-token).
# Wird eine Adresse gesetzt, legt Postwerk Konto und Domain beim ersten Start direkt an;
# ohne Passwort wird eins erzeugt und ins Log geschrieben.
POSTWERK_ADMIN_EMAIL=
POSTWERK_ADMIN_PASSWORD=

# Session-Cookie nur über HTTPS senden (empfohlen, sobald HTTPS läuft)
POSTWERK_SECURE_COOKIES=false

# Reverse-Proxy (Traefik, Nginx Proxy Manager, Caddy …) richtest du im Setup-Assistenten ein
# (Schritt „Reverse-Proxy“, inkl. fertiger Konfiguration). true erzwingt die Proxy-Auswertung zusätzlich.
POSTWERK_TRUST_PROXY=false

# Optional: eigenes Zertifikat statt Let's Encrypt (Pfade im Container)
# POSTWERK_TLS_CERT=/data/certs/fullchain.pem
# POSTWERK_TLS_KEY=/data/certs/privkey.pem

# Optional: Smarthost – einfacher im Setup-Assistenten (Schritt Internetanschluss) einzurichten.
# Diese Variablen haben Vorrang vor der Einstellung in der Oberfläche.
# POSTWERK_RELAY_HOST=smtp.provider.de:587
# POSTWERK_RELAY_USER=
# POSTWERK_RELAY_PASSWORD=

# Optional: Token für /metrics (Prometheus)
# POSTWERK_METRICS_TOKEN=

# Optional: Master-Schlüssel für verschlüsselte Geheimnisse (openssl rand -base64 32).
# Ohne Angabe wird /data/master.key erzeugt und mitgesichert. Mit dieser Variable ist der
# Schlüssel in keinem Backup – für jede Wiederherstellung wird derselbe Wert gebraucht.
# POSTWERK_MASTER_KEY=

# Host-Ports der Weboberfläche (für ACME HTTP-01 muss 80 von außen erreichbar sein)
# HTTP_PORT=80
# HTTPS_PORT=443

# Nur auf bestimmter IP lauschen
# BIND_IP=0.0.0.0

# Modelle für das Profil "ai"
AI_CHAT_MODEL=qwen2.5:7b
AI_EMBED_MODEL=nomic-embed-text

POSTWERK_DEBUG=false
